{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(plugin_ssh-mcp_)?ssh__(exec|get|put|sync_get|sync_put)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/tools/ssh-mcp-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
